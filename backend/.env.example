# Puerto donde escucha Express.
PORT=4000
# URI de MongoDB. Local (Docker): mongodb://localhost:27017 - Atlas: la URI mongodb+srv://... que da Atlas.
MONGODB_URI=mongodb://localhost:27017
# Nombre de la base de datos.
MONGODB_DB=tandem
# Secreto JWT. Debe ser largo y privado.
# Se puede generar usando el siguiente comando:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))".
JWT_SECRET=cambia-esto-por-un-secreto
# Cuánto dura el token, con el formato de jsonwebtoken.
JWT_EXPIRES=2h
# Orígenes permitidos por CORS, separados por comas (p. ej. la URL del frontend). Vacío = cualquiera (solo desarrollo).
CORS_ORIGIN=
# Intentos de login fallidos permitidos por email antes de bloquear, y minutos de bloqueo.
LOGIN_MAX_INTENTOS=5
LOGIN_VENTANA_MIN=15
