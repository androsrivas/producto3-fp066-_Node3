{
  "info": {
    "name": "Tandem P3 - API GraphQL",
    "description": "Pruebas de la API GraphQL (Producto 3). Ejecutar con Collection Runner en orden: el login guarda el token y el alta de intercambio guarda su id. Requiere el servidor en http://localhost:4000/graphql.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000/graphql"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "intercambioId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1 - Autenticacion",
      "item": [
        {
          "name": "Login correcto (guarda el token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const r = pm.response.json();",
                  "pm.test('Login correcto', () => pm.expect(r.data.login.token).to.be.a('string'));",
                  "pm.collectionVariables.set('token', r.data.login.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation {\n  login(email: \"laura@tandem.com\", password: \"1234\") {\n    token\n    usuario { id nombre email }\n  }\n}",
                "variables": "{}"
              }
            },
            "url": {
              "raw": "{{baseUrl}}",
              "host": [
                "{{baseUrl}}"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Ejecutar primero: guarda el JWT en la variable de coleccion {{token}}."
          }
        },
        {
          "name": "Login con password incorrecta",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const r = pm.response.json();",
                  "pm.test('Devuelve un error', () => pm.expect(r.errors).to.be.an('array').that.is.not.empty);",
                  "pm.test('Código BAD_USER_INPUT', () => pm.expect(r.errors[0].extensions.code).to.eql('BAD_USER_INPUT'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation {\n  login(email: \"laura@tandem.com\", password: \"mala\") {\n    token\n  }\n}",
                "variables": "{}"
